# =============================================================================
# Robotics Lab .gitignore
# Covers: Python, ROS 2, PyBullet, Gazebo, Jupyter, OS artifacts
# =============================================================================

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
*.eggs/
dist/
build/
*.whl
develop-eggs/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
.python-version
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.env.local
.env.*.local

# ── Virtual environments / Poetry / pipenv ──────────────────────────────────
poetry.lock
poetry.toml.local
Pipfile.lock

# ── IDE & Editor ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.cursor/
.trae/
*.code-workspace
.DS_Store
Thumbs.db

# ── Jupyter ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints
.jupyter/
.local/share/jupyter/

