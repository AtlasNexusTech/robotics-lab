build/
install/
log/
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
*.pyc
*.pyo
__pycache__/
ament_*/
colcon_*
COLCON_IGNORE
AMENT_IGNORE

# ── PyBullet ───────────────────────────────────────────────────────────────
*.bullet
bullet_*/
pybullet_data/
pybullet_*.log
pybullet_*.png
*.urdf.bak

# ── Gazebo ─────────────────────────────────────────────────────────────────
*.gazebo
*.world~
*.sdf.bak
